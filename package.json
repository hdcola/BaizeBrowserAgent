{
  "name": "baize-browser-agent",
  "description": "AI-powered browser agent using WXT, React, and assistant-ui.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "tsx scripts/copy-locales.ts && wxt --browser firefox",
    "dev:safari": "wxt -b safari",
    "build": "tsx scripts/copy-locales.ts && wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "tsx scripts/copy-locales.ts && wxt build --browser firefox",
    "build:safari": "wxt build -b safari",
    "zip": "tsx scripts/copy-locales.ts && wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "tsx scripts/copy-locales.ts && wxt zip --browser firefox",
    "zip:safari": "wxt zip -b safari",
    "check": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "copy-locales": "tsx scripts/copy-locales.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "latest",
    "@assistant-ui/react-markdown": "latest",
    "@google/genai": "^1.35.0",
    "openai": "^6.16.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "latest",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.2",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.4.23",
    "fs-extra": "^11.3.3",
    "jsdom": "latest",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "latest",
    "wxt": "^0.20.13"
  }
}
